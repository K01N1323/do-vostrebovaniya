; Проект «До востребования» — первый играбельный этап.
config_version=5

[application]
config/name="До востребования"
config/version="0.4.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Бюро находок старого автовокзала. Первое обращение."

[autoload]
GameStore="*res://scripts/core/game_store.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1000
window/size/min_height=700
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12,0.16,0.16,1)

[audio]
driver/enable_input=false
